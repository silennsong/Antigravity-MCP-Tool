{
  "mcpServers": {
    "antigravity_delegate": {
      "title": "Antigravity Gemini Delegate",
      "description": "Check readiness and delegate suitable Codex subtasks to Gemini through Antigravity CLI.",
      "command": "python3",
      "args": [
        "./mcp/antigravity_mcp.pyz",
        "server"
      ],
      "cwd": ".",
      "env_vars": [
        "ANTIGRAVITY_CLI",
        "ANTIGRAVITY_CLI_SETTINGS",
        "ANTIGRAVITY_DELEGATE_CONFIG",
        "ANTIGRAVITY_FLASH_MODEL",
        "ANTIGRAVITY_PRO_MODEL",
        "ANTIGRAVITY_POLICY_SEARCH_ROOT",
        "HOME",
        "PATH",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 86400
    }
  }
}
